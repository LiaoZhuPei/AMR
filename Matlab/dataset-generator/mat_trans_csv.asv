% 1. 加载包含多维数组的 .mat 文件
load('E:\M_Project\matE25\train\train.mat'); 
% 假设加载后，有一个名为 'data_cube' 的变量，其大小为 500x2x1024

% 2. 将三维数组重塑为二维矩阵
% 原始尺寸: (样本数, 通道数, 长度) -> (500, 2, 1024)
num_samples = size(data_save, 1);
num_channels = size(data_save, 2);
signal_length = size(data_save, 3);

% 我们需要将每个样本的 I 和 Q 数据拼接成一行
% 首先，我们需要将数据重新排列，使得I和Q通道数据块连续
% permute(data_cube, [1, 3, 2]) -> 500 x 1024 x 2
% 这样，每个样本的 1024 个 I 值和 1024 个 Q 值就分开了
temp_reshaped = permute(data_save, [1, 3, 2]);

% 然后，将最后两维合并成一维
% 最终尺寸: (样本数, 长度*通道数) -> 500 x (1024*2) = 500 x 2048
data_2d = reshape(temp_reshaped, num_samples, []);

fprintf('数据已从 3D (%d x %d x %d) 重塑为 2D (%d x %d)\n', ...
        num_samples, num_channels, signal_length, size(data_2d, 1), size(data_2d, 2));

% 3. 定义输出的 .csv 文件名
output_csv_file = 'E:\M_Project\matE25\matE24\train.csv';

% 4. 使用 writematrix 保存为 .csv
writematrix(data_2d, output_csv_file);

fprintf('重塑后的数据已成功保存到 %s\n', output_csv_file);