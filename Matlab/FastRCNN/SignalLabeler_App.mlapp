<?xml version="1.0" encoding="UTF-8"?><AppContainer xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mlapp="http://www.mathworks.com/ MatlabAppContainer" version="R2021a" ><Content><App auto-ГОСТ="false" class-name="SignalLabeler_App" name="SignalLabeler_App.mlapp" ><Component type="matlab.apps.AppBase" name="app" /><Code><![CDATA[classdef SignalLabeler_App < matlab.apps.AppBase    % Properties that correspond to app components    properties (Access = public)        UIFigure              matlab.ui.Figure        GridLayout            matlab.ui.container.GridLayout        OverviewAxes          matlab.ui.control.UIAxes        ZoomAxes              matlab.ui.control.UIAxes        LoadButton            matlab.ui.control.Button        SaveButton            matlab.ui.control.Button        NFFTSliderLabel       matlab.ui.control.Label        NFFTSlider            matlab.ui.control.Slider        OverlapSliderLabel    matlab.ui.control.Label        OverlapSlider         matlab.ui.control.Slider        StatusLabel           matlab.ui.control.Label    end    % Properties that correspond to signal data and state    properties (Access = private)        IQData                % Stores the full IQ data (memory mapped)        FilePath              % Path to the loaded .bin file        SampleRate = 2.048e6; % Sample Rate in Hz        DataType = 'single';  % Data type for fread, 'single' for float32                AnnotationROI         % Handle to the rectangle ROI        AnnotationFile = 'annotations_matlab.csv'; % Output file        ClassID = 0;          % Class ID for the signal                FullDuration          % Full signal duration in seconds        MemMap                % Memory map object for the large file    end    % Callbacks that handle component events    methods (Access = private)        % Code that executes after component creation        function startupFcn(app)            app.StatusLabel.Text = '请点击 "加载.bin文件" 开始...';        end        % Button pushed function: LoadButton        function LoadButtonPushed(app, event)            [file, path] = uigetfile('*.bin', '请选择一个 .bin 信号文件');            if isequal(file, 0)                app.StatusLabel.Text = '用户取消了操作。';                return;            end            app.FilePath = fullfile(path, file);            app.StatusLabel.Text = '正在加载和处理文件，请稍候...';            drawnow; % Force UI update            try                % 使用内存映射来处理大文件，避免一次性读入内存                app.MemMap = memmapfile(app.FilePath, 'Format', {app.DataType, [2, Inf], 'iq'});                num_samples = size(app.MemMap.Data.iq, 2);                app.FullDuration = num_samples / app.SampleRate;                % --- 绘制概览图 ---                % 为了性能，对概览图进行降采样                decimation_factor = 100;                overview_data_complex = app.MemMap.Data.iq(1, 1:decimation_factor:end) + 1i * app.MemMap.Data.iq(2, 1:decimation_factor:end);                                spectrogram(overview_data_complex, ...                            kaiser(256, 5), 128, 256, ...                            app.SampleRate/decimation_factor, 'centered', 'yaxis', 'power', 'Parent', app.OverviewAxes);                title(app.OverviewAxes, '概览图 (低分辨率)');                xlabel(app.OverviewAxes, '时间 (s)');                ylabel(app.OverviewAxes, '频率 (Hz)');                                % 添加交互：点击概览图进行缩放                app.OverviewAxes.ButtonDownFcn = @(~,~) app.zoom_on_click();                                app.StatusLabel.Text = sprintf('加载成功! 总时长: %.2fs. 请在概览图上点击选择缩放区域。', app.FullDuration);            catch ME                uialert(app.UIFigure, ['无法加载文件: ' ME.message], '加载错误');                app.StatusLabel.Text = '加载失败，请检查文件路径和格式。';            end        end                % Custom function to handle zooming from overview        function zoom_on_click(app)            pt = app.OverviewAxes.CurrentPoint;            t_center = pt(1,1);            zoom_duration = app.FullDuration / 10; % 默认缩放1/10的总时长            t_start = max(0, t_center - zoom_duration/2);            t_end = min(app.FullDuration, t_center + zoom_duration/2);                        app.update_zoom_plot(t_start, t_end);        end        % Function to update the zoom plot        function update_zoom_plot(app, t_start, t_end)            app.StatusLabel.Text = '正在从硬盘读取数据并渲染高清缩放图...';            drawnow;                        start_sample = round(t_start * app.SampleRate) + 1;            end_sample = round(t_end * app.SampleRate) + 1;                        % 从内存映射中读取所需的数据块            chunk = app.MemMap.Data.iq(:, start_sample:end_sample);            chunk_complex = chunk(1,:) + 1i * chunk(2,:);                        % 获取滑块参数            win_size = app.NFFTSlider.Value;            overlap = round(win_size * (app.OverlapSlider.Value / 100));            % 绘制高清语谱图            spectrogram(chunk_complex, kaiser(win_size, 5), overlap, win_size, ...                        app.SampleRate, 'centered', 'yaxis', 'power', 'Parent', app.ZoomAxes);                        title(app.ZoomAxes, sprintf('缩放视图 | 时间: %.2fs - %.2fs', t_start, t_end));            xlabel(app.ZoomAxes, '时间 (s)');            ylabel(app.ZoomAxes, '频率 (Hz)');                        % 允许在缩放图上绘制矩形            if ~isempty(app.AnnotationROI) && isvalid(app.AnnotationROI)                delete(app.AnnotationROI); % 删除旧的ROI            end            app.AnnotationROI = drawrectangle(app.ZoomAxes, 'Color', 'y');            app.StatusLabel.Text = '高清图渲染完毕。请在图上绘制或调整矩形框进行标注。';        end        % Slider value changed function: NFFTSlider, OverlapSlider        function SlidersValueChanged(app, event)            % 当滑块变化时，如果存在缩放区域，则重绘             if ~isempty(app.ZoomAxes.Children)                current_xlim = xlim(app.ZoomAxes);                app.update_zoom_plot(current_xlim(1), current_xlim(2));             end        end        % Button pushed function: SaveButton        function SaveButtonPushed(app, event)            if isempty(app.AnnotationROI) || ~isvalid(app.AnnotationROI)                app.StatusLabel.Text = '错误：请先在缩放图上绘制一个标注框。';                return;            end                        roi_pos = app.AnnotationROI.Position; % [t_start, f_low, t_width, f_height]                        % 获取当前缩放图的范围            zoom_xlim = xlim(app.ZoomAxes);            zoom_ylim = ylim(app.ZoomAxes);                        % 计算YOLO格式            x_center = roi_pos(1) + roi_pos(3)/2;            y_center = roi_pos(2) + roi_pos(4)/2;                        % 归一化            x_center_norm = (x_center - zoom_xlim(1)) / (zoom_xlim(2) - zoom_xlim(1));            y_center_norm = (y_center - zoom_ylim(1)) / (zoom_ylim(2) - zoom_ylim(1));            width_norm = roi_pos(3) / (zoom_xlim(2) - zoom_xlim(1));            height_norm = roi_pos(4) / (zoom_ylim(2) - zoom_ylim(1));                        % 写入文件            [~, filename, ~] = fileparts(app.FilePath);            annotation_line = sprintf('%s.bin,%d,%.6f,%.6f,%.6f,%.6f\n', ...                                      filename, app.ClassID, x_center_norm, y_center_norm, width_norm, height_norm);                        try                fileID = fopen(app.AnnotationFile, 'a');                fprintf(fileID, annotation_line);                fclose(fileID);                app.StatusLabel.Text = sprintf('成功! 标注已保存至 %s', app.AnnotationFile);            catch ME                app.StatusLabel.Text = ['错误：无法写入文件: ' ME.message];            end        end    end    % App initialization and construction    methods (Access = private)        % Create UIFigure and components        function createComponents(app)            % Create UIFigure and hide until all components are created            app.UIFigure = uifigure('Visible', 'off');            app.UIFigure.Position = [100 100 950 650];            app.UIFigure.Name = '专业信号标注工具 (MATLAB)';            % Create GridLayout            app.GridLayout = uigridlayout(app.UIFigure);            app.GridLayout.ColumnWidth = {'1x', 120};            app.GridLayout.RowHeight = {'1x', '3x', 30, 30, 30};            % Create OverviewAxes            app.OverviewAxes = uiaxes(app.GridLayout);            title(app.OverviewAxes, '概览图')            xlabel(app.OverviewAxes, '时间 (s)')            ylabel(app.OverviewAxes, '频率 (Hz)')            app.OverviewAxes.Layout.Row = 1;            app.OverviewAxes.Layout.Column = 1;            % Create ZoomAxes            app.ZoomAxes = uiaxes(app.GridLayout);            title(app.ZoomAxes, '缩放视图')            xlabel(app.ZoomAxes, '时间 (s)')            ylabel(app.ZoomAxes, '频率 (Hz)')            app.ZoomAxes.Layout.Row = 2;            app.ZoomAxes.Layout.Column = 1;                        % Create Control Panel            p = uipanel(app.GridLayout, 'Title', '控制面板');            p.Layout.Row = [1 5];            p.Layout.Column = 2;            controlLayout = uigridlayout(p, 'RowHeight', {'fit', 'fit', 50, 50, 50, 50, '1x'}, 'ColumnWidth', {'1x'});                        % Create LoadButton            app.LoadButton = uibutton(controlLayout, 'push', 'Text', '加载 .bin 文件', 'ButtonPushedFcn', @(src,event) LoadButtonPushed(app, event));            app.LoadButton.Layout.Row = 1; app.LoadButton.Layout.Column = 1;                        % Create SaveButton            app.SaveButton = uibutton(controlLayout, 'push', 'Text', '保存当前标注', 'ButtonPushedFcn', @(src,event) SaveButtonPushed(app, event));            app.SaveButton.Layout.Row = 2; app.SaveButton.Layout.Column = 1;            % Create NFFTSliderLabel            app.NFFTSliderLabel = uilabel(controlLayout, 'Text', 'NFFT (窗口大小)');            app.NFFTSliderLabel.Layout.Row = 3; app.NFFTSliderLabel.Layout.Column = 1;            % Create NFFTSlider            app.NFFTSlider = uislider(controlLayout, 'Limits', [256 8192], 'Value', 1024, 'MajorTicks', [256, 1024, 2048, 4096, 8192], 'ValueChangedFcn', @(src,event) SlidersValueChanged(app, event));            app.NFFTSlider.Layout.Row = 4; app.NFFTSlider.Layout.Column = 1;            % Create OverlapSliderLabel            app.OverlapSliderLabel = uilabel(controlLayout, 'Text', '重叠率 (%)');            app.OverlapSliderLabel.Layout.Row = 5; app.OverlapSliderLabel.Layout.Column = 1;            % Create OverlapSlider            app.OverlapSlider = uislider(controlLayout, 'Limits', [0 99], 'Value', 50, 'ValueChangedFcn', @(src,event) SlidersValueChanged(app, event));            app.OverlapSlider.Layout.Row = 6; app.OverlapSlider.Layout.Column = 1;            % Create StatusLabel            app.StatusLabel = uilabel(app.GridLayout, 'Text', '', 'HorizontalAlignment', 'center', 'FontSize', 14);            app.StatusLabel.Layout.Row = [3 5];            app.StatusLabel.Layout.Column = 1;            % Show the figure after all components are created            app.UIFigure.Visible = 'on';        end    end    % App creation and deletion    methods (Access = public)        % Construct app        function app = SignalLabeler_App()            % Create UIFigure and components            createComponents(app)            % Register the app with App Designer            registerApp(app, app.UIFigure)            % Execute the startup function            runStartupFcn(app, @startupFcn)            if nargout == 0                clear app            end        end        % Code that executes before app deletion        function delete(app)            % Delete UIFigure when app is deleted            delete(app.UIFigure)        end    endend]]></Code><InitialState /></App></Content></AppContainer>